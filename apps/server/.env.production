# BrowserOS Server - Production Environment
# REQUIRED: Fill in all values before building for production

# Server Ports
BROWSEROS_SERVER_PORT=9100
BROWSEROS_CDP_PORT=9000
BROWSEROS_EXTENSION_PORT=9300

# Configuration (REQUIRED for production)
# Get this from your BrowserOS team or configuration service
BROWSEROS_CONFIG_URL=https://config.browseros.com
BROWSEROS_INSTALL_ID=
BROWSEROS_CLIENT_ID=

# Analytics & Monitoring (REQUIRED for production)
# Get from https://posthog.com - Project Settings -> Project API Key
POSTHOG_API_KEY=phc_your_posthog_api_key_here

# Error Tracking (REQUIRED for production)
# Get from https://sentry.io - Settings -> Client Keys (DSN)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Get from https://sentry.io - Settings -> Auth Tokens (needs project:releases, org:read)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
# Your Sentry organization slug (from URL: sentry.io/organizations/ORG_SLUG)
SENTRY_ORG=your-org-slug
# Your Sentry project slug (from URL: sentry.io/organizations/ORG_SLUG/projects/PROJECT_SLUG)
SENTRY_PROJECT=your-project-slug

# Codegen Service (REQUIRED for production)
# Default BrowserOS service, or use your own
CODEGEN_SERVICE_URL=https://graph.browseros.com
